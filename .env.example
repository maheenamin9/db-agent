# Ollama (runs on the host; docker-compose reaches it via host.docker.internal)
OLLAMA_HOST=http://localhost:11434
SQL_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://localhost:6333

# Agent
MAX_REPAIR_RETRIES=2
ROW_LIMIT=1000

# Uploads
MAX_UPLOAD_MB=50

# Seed databases (docker-compose). The admin accounts only seed the data; the agent
# connects with READONLY_USER. When connecting from the backend container use host
# `postgres` / `mysql`; from your laptop use `localhost`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo
POSTGRES_PORT=5433   # host port only; containers still talk to postgres:5432
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=mysql
MYSQL_DATABASE=demo
READONLY_USER=readonly
READONLY_PASSWORD=readonly

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
