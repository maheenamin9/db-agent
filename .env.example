# Ollama. Defaults assume it runs on this host (docker-compose reaches it via
# host.docker.internal); point it at any reachable host:port instead if Ollama runs
# elsewhere on your network, e.g. OLLAMA_HOST=http://10.0.0.5:11434
OLLAMA_HOST=http://localhost:11434
SQL_MODEL=qwen3:30b
EMBED_MODEL=nomic-embed-text
DESCRIBE_MODEL=qwen3:8b

# Qdrant
QDRANT_URL=http://localhost:6333

# Agent
MAX_REPAIR_RETRIES=2
ROW_LIMIT=1000

# Uploads
MAX_UPLOAD_MB=50

# Google Sheets: a service account JSON key (create one in Google Cloud Console,
# enable the Sheets + Drive APIs, then share each spreadsheet with the key's
# client_email as a Viewer). Leave both unset if you don't use this connector.
# - Running the backend directly with `uv run` (no Docker): set GOOGLE_SERVICE_ACCOUNT_FILE
#   to the key's path; the app reads this file straight off your disk.
# - Running via docker-compose: set GOOGLE_SERVICE_ACCOUNT_FILE_HOST instead (also a path on
#   your machine). Compose bind-mounts it into the backend container and sets
#   GOOGLE_SERVICE_ACCOUNT_FILE to the in-container path for you.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_FILE_HOST=/path/to/service-account.json

# Seed databases (docker-compose). The admin accounts only seed the data; the agent
# connects with READONLY_USER. When connecting from the backend container use host
# `postgres` / `mysql`; from your laptop use `localhost`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo
POSTGRES_PORT=5433   # host port only; containers still talk to postgres:5432
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=mysql
MYSQL_DATABASE=demo
READONLY_USER=readonly
READONLY_PASSWORD=readonly

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
